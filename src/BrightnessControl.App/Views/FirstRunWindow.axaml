<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BrightnessControl.App.Views.FirstRunWindow"
        Title="BrightnessControl — Первый запуск"
        Width="500"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Topmost="True">
    <Border BorderBrush="#40808080" BorderThickness="1" Background="{DynamicResource AppWindowBackground}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Height="32" ColumnDefinitions="*,Auto">
                <Border x:Name="CloseButton"
                        Grid.Column="1"
                        Width="46" Height="32"
                        Background="{DynamicResource AppDanger}">
                    <TextBlock Text="✕"
                               Foreground="{DynamicResource AppDangerInk}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
            <Border DockPanel.Dock="Top" Height="3" Background="{DynamicResource AppAccentBrush}" />
            <StackPanel x:Name="Root" Margin="22" Spacing="0" />
        </DockPanel>
    </Border>
</Window>
