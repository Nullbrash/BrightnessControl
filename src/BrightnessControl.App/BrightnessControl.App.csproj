<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- FP7 — единственный источник правды для версии. Читается в рантайме
         через AppVersion.Current (Services/AppVersion.cs), нигде не завязана
         на app.manifest — тот нигде кодом не читается. -->
    <Version>0.1.0</Version>
    <!-- FP7 — без этого у exe (и у любого ярлыка на него — Пуск, Рабочий
         стол) был generic-иконка Windows, не похожая на настоящую иконку
         приложения (баг, замечен пользователем на реальной установке,
         2026-09-15). Assets/app.ico — многоразмерный (16/32/48/256),
         сгенерирован из ТОЙ ЖЕ отрисовки, что и живая иконка трея
         (TrayIconRenderer.RenderIcoBytes, дизайн Spokes + цвет #F2900C —
         значения по умолчанию из TraySettings), чтобы статичная иконка
         совпадала с тем, что пользователь реально увидит в трее. Не имеет
         отношения к самой живой иконке трея (та рисуется на лету через
         Shell_NotifyIcon, независимо от этого файла). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Native\" />
    <Folder Include="Services\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BrightnessControl.Core\BrightnessControl.Core.csproj" />
  </ItemGroup>
</Project>
