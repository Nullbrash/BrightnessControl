<Project>
  <!--
    FP7 — публикационные свойства живут ЗДЕСЬ, а не в основном .csproj —
    осознанно: RuntimeIdentifier/SelfContained меняют структуру папки сборки
    (появляется подпапка win-x64) и раздувают обычный `dotnet build`/`dotnet
    run` копированием всего self-contained рантайма даже для Debug-сборки в
    процессе разработки. Профиль применяется только явным
    `dotnet publish -p:PublishProfile=win-x64`, обычный цикл разработки не
    затрагивается.

    Триминг (PublishTrimmed) сознательно НЕ включён — Avalonia (XAML/
    рефлексия), System.Drawing.Common (GDI+ marshaling) и System.Management
    (WMI COM interop) тихо ломаются триммингом без ошибок компиляции.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net9.0-windows10.0.19041.0\publish\win-x64\</PublishDir>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
